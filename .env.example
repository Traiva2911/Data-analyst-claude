# ŠABLONA proměnných prostředí.
# Zkopíruj na ".env" (je v .gitignore) a doplň své hodnoty:
#     cp .env.example .env

# Anthropic API klíč pro AI insighty (modul src/ai.py).
ANTHROPIC_API_KEY=sk-ant-...

# ID Google Ads účtu, ze kterého stahuješ data (účet "panopro").
# Můžeš zadat s pomlčkami i bez - kód si je sám odstraní.
GOOGLE_ADS_CUSTOMER_ID=123-456-7890

# --- Alternativa ke google-ads.yaml ---
# Pokud nechceš YAML soubor, knihovna google-ads umí číst i tyto proměnné.
# Stačí vyplnit jen jednu z variant (YAML NEBO tyto proměnné).
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_USE_PROTO_PLUS=True
